{
  "name": "orbyss-forms-workspace",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.20.0",
    "npm": "11.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build --workspace=@orbyss-io/forms-angular",
    "test": "npm run build && node --test tests/runtime.test.mjs",
    "test:browser": "npm run build && node tests/forms-browser/build.mjs && node tests/forms-browser/browser.mjs",
    "check": "npm run test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
