{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbyss.io/program-kit/bootstrap-decisions.schema.json",
  "title": "Program Kit bootstrap decision register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "default_profile",
    "selected_profiles",
    "choices",
    "overrides",
    "acknowledgements",
    "unresolved",
    "deferred"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "default_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "program-kit-standard" },
        "version": { "$ref": "#/$defs/text" }
      }
    },
    "selected_profiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/text" },
      "uniqueItems": true
    },
    "dotnet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_runtime", "host_source", "program_kit_host_opt_out", "opt_out_reason"],
      "properties": {
        "host_runtime": { "$ref": "#/$defs/text" },
        "host_source": { "$ref": "#/$defs/text" },
        "program_kit_host_opt_out": { "type": "boolean" },
        "opt_out_reason": { "type": "string" }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secure_profile", "profile_source", "browser_ui", "override_reason", "threat_model", "security_evidence"],
      "properties": {
        "secure_profile": { "$ref": "#/$defs/text" },
        "profile_source": { "$ref": "#/$defs/text" },
        "browser_ui": { "type": "boolean" },
        "override_reason": { "type": "string" },
        "threat_model": { "$ref": "#/$defs/text" },
        "security_evidence": { "$ref": "#/$defs/text" }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "pins", "override_reason"],
      "properties": {
        "source": { "enum": ["program-kit-default", "override"] },
        "pins": {
          "type": "object",
          "propertyNames": { "type": "string", "pattern": "^[A-Za-z0-9@][A-Za-z0-9._/@-]*$", "maxLength": 120 },
          "additionalProperties": { "$ref": "#/$defs/text" },
          "minProperties": 1
        },
        "override_reason": { "type": "string", "maxLength": 2000 }
      }
    },
    "choices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "decision", "source", "rationale", "override"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "decision": { "$ref": "#/$defs/text" },
          "source": { "enum": ["explicit-intake", "program-kit-default", "derived-default", "override"] },
          "rationale": { "$ref": "#/$defs/text" },
          "override": { "$ref": "#/$defs/text" }
        }
      }
    },
    "overrides": { "$ref": "#/$defs/decisions" },
    "acknowledgements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "summary"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "summary": { "$ref": "#/$defs/text" }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "blocks"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "question": { "$ref": "#/$defs/text" },
          "blocks": { "$ref": "#/$defs/text" }
        }
      }
    },
    "deferred": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "trigger"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "question": { "$ref": "#/$defs/text" },
          "trigger": { "$ref": "#/$defs/text" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 120 },
    "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "decision"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "decision": { "$ref": "#/$defs/text" }
        }
      }
    }
  }
}
