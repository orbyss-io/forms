{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbyss.io/program-kit/bootstrap-context.schema.json",
  "title": "Program Kit compact bootstrap stage brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "stage",
    "stage_focus",
    "bootstrap_intake",
    "intake",
    "architecture_map",
    "authorities",
    "managed_profile_pins",
    "decisions",
    "governance",
    "output_contract",
    "evidence_index",
    "reading_policy"
  ],
  "properties": {
    "schema_version": { "const": "3.0" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "stage": { "enum": ["research", "architecture", "tooling", "roadmap", "readiness"] },
    "stage_focus": { "type": "string", "minLength": 1 },
    "bootstrap_intake": { "$ref": "#/$defs/file" },
    "intake": { "$ref": "#/$defs/intake_projection" },
    "architecture_map": { "$ref": "#/$defs/architecture_projection" },
    "authorities": { "type": "object", "additionalProperties": { "type": "object" } },
    "managed_profile_pins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["precedence", "selected_profiles", "pins", "sources", "local_environment_policy"],
      "properties": {
        "precedence": { "const": "program-kit-managed-profile-before-local-environment-or-current-candidate" },
        "selected_profiles": { "$ref": "#/$defs/string_list" },
        "pins": {
          "type": "object",
          "propertyNames": { "type": "string", "minLength": 1 },
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "sha256", "bytes", "profile"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "#/$defs/sha256" },
              "bytes": { "type": "integer", "minimum": 0 },
              "profile": { "type": "string", "minLength": 1 },
              "provides": { "$ref": "#/$defs/string_list" },
              "verifies": { "type": "string", "minLength": 1 },
              "settings": { "type": "object" }
            }
          }
        },
        "local_environment_policy": { "type": "string", "minLength": 1 }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "title", "status"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "title": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "configuration_sources"],
      "properties": {
        "paths": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decisions", "specification_roadmap", "constitution_document", "constitution_ratification"],
          "properties": {
            "decisions": { "type": "string", "minLength": 1 },
            "specification_roadmap": { "type": "string", "minLength": 1 },
            "constitution_document": { "type": "string", "minLength": 1 },
            "constitution_ratification": { "type": "string", "minLength": 1 }
          }
        },
        "configuration_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "exists"],
            "properties": {
              "path": { "type": "string" },
              "exists": { "type": "boolean" },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["write_paths", "contract_references", "validation_commands", "artifact_byte_budgets"],
      "properties": {
        "write_paths": { "$ref": "#/$defs/string_list" },
        "contract_references": { "$ref": "#/$defs/string_list" },
        "validation_commands": { "$ref": "#/$defs/string_list" },
        "artifact_byte_budgets": {
          "type": "object",
          "propertyNames": { "type": "string", "minLength": 1 },
          "additionalProperties": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "evidence_index": { "$ref": "#/$defs/file" },
    "reading_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "required_full_reads", "allowed_sources", "rules", "provenance"],
      "properties": {
        "mode": { "const": "deny-by-default" },
        "required_full_reads": { "$ref": "#/$defs/string_list" },
        "allowed_sources": { "$ref": "#/$defs/string_list" },
        "rules": { "$ref": "#/$defs/string_list" },
        "provenance": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "intake_projection": {
      "type": "object",
      "required": ["projection", "schema_version", "status", "project"],
      "properties": {
        "projection": { "const": "stage-summary" },
        "schema_version": { "const": "1.0" },
        "status": { "const": "confirmed" },
        "project": { "type": "object" }
      },
      "additionalProperties": true
    },
    "architecture_projection": {
      "type": "object",
      "required": ["projection", "source", "schema_version", "model_id", "title"],
      "properties": {
        "projection": { "const": "stage-summary" },
        "source": { "$ref": "#/$defs/file" },
        "schema_version": { "const": "1.0" },
        "model_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "string_list": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
