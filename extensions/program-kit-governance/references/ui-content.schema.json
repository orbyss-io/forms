{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://orbyss.io/program-kit/ui-content.schema.json",
  "title":"Program Kit public content contract v1",
  "type":"object","additionalProperties":false,"required":["version","origin","pages"],
  "properties":{
    "version":{"const":"1.0"},"origin":{"$ref":"#/$defs/text"},
    "pages":{"type":"array","maxItems":1000,"items":{"$ref":"#/$defs/page"}}
  },
  "$defs":{
    "text":{"type":"string","minLength":1,"maxLength":10000},
    "id":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,79}$"},
    "page":{
      "type":"object","additionalProperties":false,
      "required":["id","path","intent","index","title","description","language","lastModified","blocks"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},"path":{"$ref":"#/$defs/text"},
        "intent":{"enum":["private-app","public-utility","public-landing","public-content"]},
        "index":{"type":"boolean"},"title":{"$ref":"#/$defs/text"},"description":{"$ref":"#/$defs/text"},
        "language":{"type":"string","pattern":"^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"},
        "direction":{"enum":["ltr","rtl"]},"lastModified":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},
        "alternates":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
        "image":{"type":"object","additionalProperties":false,"required":["url","alt"],"properties":{"url":{"$ref":"#/$defs/text"},"alt":{"$ref":"#/$defs/text"}}},
        "article":{"type":"object","additionalProperties":false,"required":["author","authorType","datePublished"],"properties":{"author":{"$ref":"#/$defs/text"},"authorType":{"enum":["Person","Organization"]},"datePublished":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"}}},
        "product":{"type":"object","additionalProperties":false,"required":["type","price","currency","unit","region","terms"],"properties":{
          "type":{"enum":["Product","SoftwareApplication"]},"price":{"type":"string","pattern":"^[0-9]+(\\.[0-9]{1,2})?$"},
          "currency":{"type":"string","pattern":"^[A-Z]{3}$"},"unit":{"$ref":"#/$defs/text"},"region":{"$ref":"#/$defs/text"},"terms":{"$ref":"#/$defs/text"}
        }},
        "blocks":{"type":"array","maxItems":500,"items":{"$ref":"#/$defs/block"}}
      }
    },
    "block":{
      "type":"object","additionalProperties":false,"required":["type"],
      "properties":{
        "type":{"enum":["heading","paragraph","list","table","link"]},
        "text":{"$ref":"#/$defs/text"},"id":{"$ref":"#/$defs/id"},"url":{"$ref":"#/$defs/text"},
        "items":{"type":"array","minItems":1,"maxItems":1000,"items":{"$ref":"#/$defs/text"}},
        "headers":{"type":"array","minItems":1,"maxItems":20,"items":{"$ref":"#/$defs/text"}},
        "rows":{"type":"array","minItems":1,"maxItems":1000,"items":{"type":"array","minItems":1,"maxItems":20,"items":{"$ref":"#/$defs/text"}}}
      }
    }
  }
}
