{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://orbyss.io/program-kit/ui-profile.schema.json",
  "title":"Program Kit UI experience v1",
  "type":"object","additionalProperties":false,
  "required":["profile","archetype","navigation","density","brand","scheme","motion","css","discovery","budgets"],
  "properties":{
    "profile":{"const":"ui-experience-v1"},
    "archetype":{"enum":["journey","product-shell","workspace","content-hub","showcase"]},
    "navigation":{"enum":["sidebar","top","contextual","none"]},
    "density":{"enum":["comfortable","compact"]},
    "scheme":{"enum":["system","light","dark"]},
    "motion":{"enum":["subtle","expressive"]},
    "css":{"enum":["native","tailwind","existing-system"]},
    "analytics":{"type":"object","additionalProperties":false,"required":["provider"],"properties":{
      "provider":{"enum":["none","custom","ga4"]},
      "measurementId":{"type":"string","pattern":"^G-[A-Z0-9]+$"},
      "events":{"type":"array","uniqueItems":true,"maxItems":100,"items":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,79}$"}}
    }},
    "brand":{
      "type":"object","additionalProperties":false,
      "required":["name","primary","secondary","fontStack","fontLicense","character","shape"],
      "properties":{
        "name":{"$ref":"#/$defs/text"},"primary":{"$ref":"#/$defs/color"},"secondary":{"$ref":"#/$defs/color"},
        "fontStack":{"type":"string","pattern":"^[A-Za-z0-9 ,'-]+$","minLength":1,"maxLength":200},
        "fontLicense":{"$ref":"#/$defs/text"},
        "character":{"enum":["quiet","balanced","expressive"]},"shape":{"enum":["square","rounded","pill"]},
        "logo":{"$ref":"#/$defs/image"},"favicon":{"$ref":"#/$defs/text"},
        "icons":{"type":"object","additionalProperties":false,"required":["bundle"],"properties":{
          "bundle":{"enum":["lucide","custom","none"]},"license":{"$ref":"#/$defs/text"},"source":{"$ref":"#/$defs/text"},
          "assets":{"type":"object","additionalProperties":{"type":"string","minLength":1,"maxLength":262144}}
        }},
        "overrides":{"type":"object","additionalProperties":false,"properties":{"light":{"$ref":"#/$defs/colors"},"dark":{"$ref":"#/$defs/colors"}}}
      }
    },
    "discovery":{
      "type":"object","additionalProperties":false,"required":["search","training","userFetch","markdown","llms"],
      "properties":{
        "search":{"type":"boolean"},"training":{"type":"boolean"},"userFetch":{"type":"boolean"},
        "markdown":{"type":"boolean"},"llms":{"type":"boolean"}
      }
    },
    "budgets":{
      "type":"object","additionalProperties":false,"required":["cssBytes","jsBytes","htmlBytes"],
      "properties":{"cssBytes":{"$ref":"#/$defs/budget"},"jsBytes":{"$ref":"#/$defs/budget"},"htmlBytes":{"$ref":"#/$defs/budget"}}
    }
  },
  "$defs":{
    "text":{"type":"string","minLength":1,"maxLength":2000},
    "color":{"type":"string","pattern":"^#[0-9a-fA-F]{6}$"},
    "budget":{"type":"integer","minimum":1024,"maximum":1000000},
    "image":{"type":"object","additionalProperties":false,"required":["alt"],"properties":{"url":{"$ref":"#/$defs/text"},"svg":{"type":"string","minLength":1,"maxLength":262144},"alt":{"$ref":"#/$defs/text"}}},
    "colors":{"type":"object","additionalProperties":false,"properties":{
      "surface":{"$ref":"#/$defs/color"},"on-surface":{"$ref":"#/$defs/color"},
      "muted":{"$ref":"#/$defs/color"},"on-muted":{"$ref":"#/$defs/color"},
      "primary":{"$ref":"#/$defs/color"},"on-primary":{"$ref":"#/$defs/color"},
      "secondary":{"$ref":"#/$defs/color"},"on-secondary":{"$ref":"#/$defs/color"},
      "danger":{"$ref":"#/$defs/color"},"on-danger":{"$ref":"#/$defs/color"},
      "focus":{"$ref":"#/$defs/color"},"border":{"$ref":"#/$defs/color"}
    }}
  }
}
