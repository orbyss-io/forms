{
  "schemaVersion": 1,
  "profile": "spa-pkce-v1",
  "assurance": {
    "threatModel": "program-kit-web-threat-model-v1",
    "evidenceProfile": "program-kit-web-security-evidence-v1"
  },
  "origins": {
    "application": "http://localhost:5173",
    "api": "http://localhost:5000",
    "identity": "http://localhost:8080"
  },
  "client": {
    "clientId": "program-kit-spa",
    "audience": "program-kit-api",
    "flow": "authorization-code-pkce-s256",
    "tokenStorage": "memory-only",
    "browserRefreshBehavior": "locally-signed-out-unless-provider-session-reestablishes-login",
    "redirectUris": [
      "http://localhost:5173/auth/callback",
      "http://localhost:5173/auth/renew-callback"
    ],
    "postLogoutRedirectUris": [ "http://localhost:5173/signed-out" ],
    "scopes": [ "openid", "profile", "program-kit-api" ],
    "silentRenewTimeoutSeconds": 10
  },
  "session": {
    "idleMinutes": 30,
    "absoluteMinutes": 480,
    "absoluteDeadlineClaim": "auth_time",
    "tokenExpiryClaim": "exp",
    "crossTabCoordination": "required-no-token-payload",
    "providerLogoutFailure": "local-session-remains-cleared",
    "authoritativeEnforcement": [
      "keycloak-sso-session",
      "browser-spa-session-adapter",
      "api-token-lifetime"
    ],
    "silentRenewRule": "preserve-original-auth_time-and-never-extend-absolute-deadline"
  },
  "errors": {
    "mediaType": "application/problem+json",
    "authentication": "authentication_required",
    "authorization": "authorization_denied"
  },
  "localization": {
    "defaultLocale": "en",
    "supportedLocales": [ "en", "nl", "fr", "de", "es" ],
    "missingKeyBehavior": "fail-tests"
  },
  "budgetsSeconds": {
    "identityDiscovery": 3,
    "applicationControlledOutcome": 5,
    "remoteAuthentication": 10
  }
}
