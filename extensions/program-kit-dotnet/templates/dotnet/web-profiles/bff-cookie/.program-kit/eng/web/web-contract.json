{
  "schemaVersion": 2,
  "profile": "bff-cookie-v1",
  "assurance": {
    "threatModel": "program-kit-web-threat-model-v1",
    "evidenceProfile": "program-kit-web-security-evidence-v1"
  },
  "origins": {
    "application": "http://localhost:5000",
    "identity": "http://localhost:8080"
  },
  "ownership": {
    "managedExactPaths": [
      "/bff/login",
      "/bff/user",
      "/bff/antiforgery",
      "/bff/logout",
      "/bff/signed-out",
      "/bff/access-denied",
      "/signin-oidc",
      "/signout-callback-oidc",
      "/signout-oidc"
    ],
    "featureOwnedPrefix": "/api/"
  },
  "routes": {
    "login": {
      "path": "/bff/login",
      "method": "GET",
      "anonymous": true,
      "query": { "returnUrl": "optional-local-absolute-path" },
      "success": { "status": 302, "location": "identity-provider-authorization-endpoint" }
    },
    "user": {
      "path": "/bff/user",
      "method": "GET",
      "anonymous": true,
      "success": {
        "status": 200,
        "contentType": "application/json",
        "anonymousBody": { "authenticated": false },
        "authenticatedBody": {
          "authenticated": true,
          "issuer": "non-empty-validated-uri-string",
          "subject": "non-empty-string",
          "displayName": "string-or-null",
          "permissions": "sorted-distinct-string-array"
        },
        "invalidIdentity": {
          "status": 401,
          "code": "authentication_identity_invalid",
          "localSession": "cleared"
        }
      }
    },
    "antiforgery": {
      "path": "/bff/antiforgery",
      "method": "GET",
      "anonymous": true,
      "success": {
        "status": 200,
        "contentType": "application/json",
        "body": {
          "headerName": "X-CSRF-TOKEN",
          "formFieldName": "__RequestVerificationToken",
          "requestToken": "non-empty-string"
        }
      }
    },
    "logout": {
      "path": "/bff/logout",
      "method": "POST",
      "authentication": "required",
      "antiforgeryTransports": ["X-CSRF-TOKEN-header", "__RequestVerificationToken-form-field"],
      "browserInvocation": "user-initiated-top-level-form-target",
      "localState": "cleared-before-provider-logout",
      "success": { "status": 302, "location": "identity-provider-end-session-endpoint" },
      "failure": { "status": 400, "code": "invalid_antiforgery_token", "localStateMutated": false }
    },
    "signedOut": {
      "path": "/bff/signed-out",
      "method": "GET",
      "anonymous": true,
      "success": { "status": 200, "contentType": "application/json", "body": { "signedOut": true } },
      "browserStateQuery": { "remote": ["pending", "unavailable"] }
    },
    "accessDenied": {
      "path": "/bff/access-denied",
      "method": "GET",
      "anonymous": true,
      "problemOutcomes": [
        { "status": 403, "code": "authorization_denied" },
        { "status": 400, "code": "authentication_callback_invalid" },
        { "status": 503, "code": "identity_provider_unavailable" }
      ]
    },
    "oidcCallback": {
      "path": "/signin-oidc",
      "owner": "openid-connect-middleware",
      "browserBehavior": "provider-response-only; application navigation is not supported"
    },
    "signedOutCallback": {
      "path": "/signout-callback-oidc",
      "owner": "openid-connect-middleware",
      "successLocation": "/bff/signed-out"
    },
    "remoteSignOut": {
      "path": "/signout-oidc",
      "owner": "openid-connect-middleware",
      "purpose": "provider-initiated-session-notification"
    }
  },
  "sessionLifecycle": {
    "expiredObservation": "user.authenticated-false-after-previously-authenticated",
    "expiredBrowserState": "session_expired",
    "providerLogoutFailure": "local-session-remains-cleared-and-signed-out-page-remains-authoritative"
  },
  "errors": {
    "mediaType": "application/problem+json",
    "authentication": "authentication_required",
    "identity": "authentication_identity_invalid",
    "authorization": "authorization_denied",
    "antiforgery": "invalid_antiforgery_token",
    "callback": "authentication_callback_invalid",
    "identityProvider": "identity_provider_unavailable"
  },
  "localization": {
    "defaultLocale": "en",
    "supportedLocales": ["en", "nl", "fr", "de", "es"],
    "missingKeyBehavior": "fail-tests"
  },
  "budgetsSeconds": {
    "identityDiscovery": 3,
    "applicationControlledOutcome": 5,
    "remoteAuthentication": 10
  }
}
