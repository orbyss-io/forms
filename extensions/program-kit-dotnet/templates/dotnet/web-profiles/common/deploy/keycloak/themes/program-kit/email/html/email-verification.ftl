<#ftl output_format="HTML">
<!doctype html>
<html lang="en"><body style="margin:0;background:#f4f7fb;color:#172033;font-family:Arial,sans-serif">
<div data-program-kit-email="email-verification-v1" style="max-width:560px;margin:32px auto;background:#fff;border-radius:16px;padding:36px">
  <p style="font-size:13px;font-weight:700;letter-spacing:.12em;color:#536dfe;text-transform:uppercase">Program Kit</p>
  <h1>Verify your email address</h1>
  <p style="font-size:16px;line-height:1.6">Confirm this address for your ${realmName} account within ${linkExpirationFormatter(linkExpiration)}.</p>
  <p><a href="${link}" style="display:inline-block;background:#4355db;color:#fff;text-decoration:none;font-weight:700;padding:13px 20px;border-radius:9px">Verify email</a></p>
  <p style="font-size:13px;color:#62708a">If you did not expect this message, you can ignore it.</p>
</div></body></html>
